# Real values belong in Render > Environment or an untracked local .env.
NODE_ENV=development
PORT=3000
SITE_URL=https://teampeach.org
APP_BASE_URL=https://teampeach.org
TRUSTED_ORIGINS=https://teampeach.org,https://www.teampeach.org
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
BREVO_API_KEY=REPLACE_WITH_BREVO_API_KEY_NOT_SMTP_PASSWORD
BREVO_SENDER_EMAIL=no-reply@auth.teampeach.org
BREVO_SENDER_NAME=TeamPeach
BREVO_MARKETING_LIST_ID=REPLACE_WITH_NUMERIC_BREVO_LIST_ID
OTP_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
RATE_LIMIT_SECRET=REPLACE_WITH_ANOTHER_DISTINCT_RANDOM_SECRET_AT_LEAST_32_BYTES
BREVO_WEBHOOK_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_EMAILS=you@example.com
EMAIL_DAILY_SOFT_LIMIT=250
EMAIL_TRANSACTIONAL_RESERVE=50
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=7