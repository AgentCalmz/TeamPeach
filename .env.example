# Real values belong in Render > Environment or an untracked local .env.
NODE_ENV=development
PORT=3000
# SITE_URL, APP_BASE_URL and TRUSTED_ORIGINS can be omitted on Render until your custom domain is connected.
# Render's external URL is used automatically for temporary deployments.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional API key, used only when EMAIL_TRANSPORT=brevo-api (or auto with a non-empty key).
# Render Free blocks SMTP ports 25/465/587; port 2525 is the SMTP alternative.
BREVO_API_KEY=
# Use smtp to force the SMTP credentials even when an older BREVO_API_KEY is still present.
# Use brevo-api for HTTPS API, or auto to choose the API if BREVO_API_KEY is set.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_YOUR_BREVO_SMTP_LOGIN
SMTP_PASS=REPLACE_WITH_YOUR_BREVO_SMTP_KEY
BREVO_SENDER_EMAIL=REPLACE_WITH_YOUR_VERIFIED_SENDER_EMAIL
BREVO_SENDER_NAME=TeamPeach
OTP_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_BYTES
RATE_LIMIT_SECRET=REPLACE_WITH_ANOTHER_DISTINCT_RANDOM_SECRET_AT_LEAST_32_BYTES
ADMIN_EMAILS=you@example.com
EMAIL_DAILY_SOFT_LIMIT=250
EMAIL_TRANSACTIONAL_RESERVE=50
OTP_TTL_MINUTES=10
SESSION_TTL_DAYS=7
